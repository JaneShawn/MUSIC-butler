# Kimi API (用于LLM生成描述和推荐)
KIMI_API_KEY=your_kimi_api_key_here

# MusicBrainz (可选，用于元数据查询)
MUSICBRAINZ_USER_AGENT=MusicAgent/1.0 (your-email@example.com)

# Reddit API (可选，用于Scout Agent发现新音乐)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=MusicAgent/1.0

# 音频指纹 (可选，从https://acoustid.org/api-key获取)
ACOUSTID_API_KEY=your_acoustid_api_key

# 配置
MUSIC_LIBRARY_PATH=C:\Users\JaneShown\Desktop\music
DATA_DIR=./data
